def classify_segment(segment, query):
    # Define relevance criteria
    relevance_criteria = {
        "relevant": lambda x: x and query in x,
        "irrelevant": lambda x: not x or query not in x
    }

    # Check if segment is relevant to the query
    if relevance_criteria["relevant"](segment):
        return {
            "reasoning": "This segment contains information relevant to the query.",
            "final_label": "Relevant"
        }
    else:
