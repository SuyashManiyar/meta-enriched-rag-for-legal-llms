# Meta-Enriched RAG for Legal LLMs - Environment Configuration

# =============================================================================
# API Keys (Optional - only if using external services)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# =============================================================================
# Model Configurations
# =============================================================================
# Embedding model for dense retrieval
EMBEDDING_MODEL=thenlper/gte-large
# Alternative models: sentence-transformers/all-MiniLM-L6-v2, intfloat/e5-large-v2

# Chunking parameters
CHUNK_SIZE=380
WINDOW_SIZE=50
OVERLAP_SIZE=20

# Retrieval parameters
TOP_K_RETRIEVAL=64
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# =============================================================================
# Data Paths
# =============================================================================
# Main data directory
DATA_DIR=./australian_legal_data

# Document directories
DOCUMENTS_DIR=./australian_legal_documents_final
CHUNKS_DIR=./australian_legal_data/generated_chunks

# Results directories
RESULTS_DIR=./results
BASELINE_RESULTS_DIR=./australian_legal_data/results_recursive
ENHANCED_RESULTS_DIR=./australian_legal_data/results_meta_recursive

# =============================================================================
# Processing Configuration
# =============================================================================
# Device configuration
DEVICE=auto  # Options: auto, cpu, cuda, mps
BATCH_SIZE=32
NUM_WORKERS=4

# Memory management
MAX_MEMORY_GB=16
CACHE_EMBEDDINGS=true
CLEAR_CACHE_BETWEEN_RUNS=false

# =============================================================================
# Evaluation Settings
# =============================================================================
# Statistical analysis
BOOTSTRAP_ITERATIONS=30
CONFIDENCE_LEVEL=0.95
RANDOM_SEED=42

# Metrics to compute
COMPUTE_DRM=true
COMPUTE_SPAN_METRICS=true
COMPUTE_ALT_METRICS=true

# =============================================================================
# Logging and Output
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/rag_experiments.log
SAVE_INTERMEDIATE_RESULTS=true

# Visualization
GENERATE_PLOTS=true
PLOT_FORMAT=png  # Options: png, pdf, svg
PLOT_DPI=300

# =============================================================================
# Web Scraping (Optional)
# =============================================================================
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3

# User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36